name: Build Kivy APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            git zip unzip openjdk-17-jdk python3-pip autoconf automake \
            libtool pkg-config zlib1g-dev libncurses-dev cmake \
            libffi-dev libssl-dev
          pip install --upgrade pip cython==0.29.36 buildozer setuptools wheel

      - name: Initialize buildozer.spec if missing
        run: |
          if [ ! -f buildozer.spec ]; then
            buildozer init
            sed -i 's/title = My Application/title = PO Budget App/' buildozer.spec
            sed -i 's/package.name = myapp/package.name = pobudgetapp/' buildozer.spec
            sed -i 's/package.domain = org.test/package.domain = org.example/' buildozer.spec
            sed -i 's/requirements = python3,kivy/requirements = python3,kivy/' buildozer.spec
          fi

      - name: Build Android APK
        run: buildozer android debug

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: po-budget-apk
          path: bin/*.apk
